# Copy to `.env` for local development. Never commit `.env`.
#
# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Runtime ---

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role is used only by the reviewer CLI and ingestion. Never by the SPA.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres ---

# Alembic and schema work use the direct session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# The API connects with the non-owner `app_runtime` role so FORCE RLS applies.
# Use the session pooler or a bounded direct pool; add `?prepare_threshold=0`
# when connecting through the transaction pooler.
DATABASE_RUNTIME_URL=postgresql+psycopg://app_runtime:your-runtime-password@db.your-project-ref.supabase.co:5432/postgres

# --- AI provider (OpenAI-compatible) ---

AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=sk-your-provider-api-key
LLM_MODEL_NAME=gpt-4.1-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VISION_MODEL_NAME=gpt-4.1-mini
STT_MODEL_NAME=gpt-4o-mini-transcribe
TTS_MODEL_NAME=gpt-4o-mini-tts

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# --- Trial-credit budget (USD) ---

TRIAL_CREDIT_BUDGET_USD=5.00
MAX_TURN_INPUT_TOKENS=8000
MAX_TURN_OUTPUT_TOKENS=1500
TURN_TIMEOUT_SECONDS=20
MAX_TURNS_PER_SESSION=30

# --- Retrieval and prompts ---

RETRIEVAL_TOP_K=12
RRF_K=60
PROMPT_VERSION=v0.1.0
